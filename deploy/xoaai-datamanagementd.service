[Unit]
Description=XOAAI Data Management Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=xoaai
Group=xoaai
WorkingDirectory=/opt/xoaai
ExecStart=/opt/xoaai/datamanagementd \
  -socket-path /tmp/sub2api-datamanagement.sock \
  -sqlite-path /var/lib/xoaai/datamanagement/datamanagementd.db \
  -version 1.0.0
Restart=always
RestartSec=5s
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
